# DEX/CEX Arbitrage Bot - Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to version control!

# ==========================================
# CEX Exchange API Credentials
# ==========================================

# Binance API credentials
CEX_API_KEY=your_binance_api_key_here
CEX_SECRET=your_binance_secret_key_here

# Alternative exchanges (uncomment if using)
# COINBASE_API_KEY=your_coinbase_api_key
# COINBASE_SECRET=your_coinbase_secret
# KRAKEN_API_KEY=your_kraken_api_key
# KRAKEN_SECRET=your_kraken_secret

# ==========================================
# DEX Data Source API
# ==========================================

# Optional - only if your DEX data source requires authentication
DEX_API_KEY=

# ==========================================
# Trading Configuration
# ==========================================

# Portfolio value in USD
PORTFOLIO_VALUE=10000.0

# Maximum position size (as decimal, 0.01 = 1%)
MAX_POSITION_SIZE=0.01

# Price movement threshold for rebalancing (as decimal, 0.02 = 2%)
PRICE_THRESHOLD=0.02

# Rebalance delay in seconds (120 = 2 minutes)
REBALANCE_DELAY=120

# Order spread range (as decimal, 0.02 = 2%)
SPREAD_RANGE=0.02

# ==========================================
# Risk Management
# ==========================================

# Stop loss percentage (as decimal, 0.05 = 5%)
STOP_LOSS_PCT=0.05

# Maximum daily trades per symbol
MAX_DAILY_TRADES=100

# Minimum order quantity
MIN_QUANTITY=0.001

# Maximum order quantity
MAX_QUANTITY=1.0

# ==========================================
# System Settings
# ==========================================

# Sandbox/Paper trading mode (true/false)
SANDBOX_MODE=true

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Data retention in days
DATA_RETENTION_DAYS=30

# ==========================================
# Advanced Settings
# ==========================================

# Exchange to use for CEX trading
CEX_EXCHANGE=binance

# DEX price data source
DEX_SOURCE=coingecko

# Trading symbols (comma-separated)
SYMBOLS=BTC/USDT,ETH/USDT

# ==========================================
# Security Notes
# ==========================================
#
# 1. NEVER share your API keys with anyone
# 2. Enable IP restrictions on your exchange API keys
# 3. Use read-only keys for monitoring, trading keys only when needed
# 4. Start with sandbox mode enabled (SANDBOX_MODE=true)
# 5. Keep this file secure and never commit to git
# 6. Rotate your API keys regularly
# 7. Use minimal permissions required for your trading strategy
#
# ==========================================
